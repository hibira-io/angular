{
  "name": "@hibira-io/angular",
  "version": "0.2.0",
  "description": "Angular signals for pusher-js on Hibira and other Pusher-compatible servers: shared channels, events, presence, connection state, client events, and LLM token streaming with streamToChannel",
  "keywords": [
    "angular",
    "signals",
    "pusher",
    "pusher-js",
    "laravel-echo",
    "websocket",
    "realtime",
    "presence",
    "llm",
    "ai",
    "streaming",
    "hibira"
  ],
  "homepage": "https://hibira.io",
  "bugs": {
    "url": "https://github.com/hibira-io/angular/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hibira-io/angular.git"
  },
  "license": "MIT",
  "author": "Hibira (https://hibira.io)",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "default": "./server.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "client.d.ts",
    "stream.js",
    "stream.d.ts",
    "agent.js",
    "agent.d.ts",
    "server.js",
    "server.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/e2e/*.e2e.mjs",
    "typecheck": "tsc -p test/tsconfig.json"
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0",
    "pusher-js": ">=7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "jsdom": "^27.4.0",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "rxjs": "^7.8.2",
    "typescript": "5.9",
    "zone.js": "^0.16.3"
  }
}
